# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=research_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_pass@127.0.0.1:5432/research_db

# External Paper API Integrations
# OpenAlex polite pool email (enables 100k requests/day and 10 req/sec)
OPENALEX_EMAIL=researcher@example.edu
S2_API_KEY=
INGESTION_SOURCES=openalex,semantic_scholar,arxiv,pubmed,crossref
OPENALEX_BASE_URL=https://api.openalex.org/works
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1/paper/search
ARXIV_BASE_URL=https://export.arxiv.org/api/query
PUBMED_SEARCH_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi
PUBMED_SUMMARY_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esummary.fcgi
CROSSREF_BASE_URL=https://api.crossref.org/works
UNPAYWALL_BASE_URL=https://api.unpaywall.org/v2
OPENALEX_LIMIT=60
SEMANTIC_SCHOLAR_LIMIT=30
SEMANTIC_SCHOLAR_RATE_LIMIT_COOLDOWN_SECONDS=900
ARXIV_LIMIT=30
PUBMED_LIMIT=30
CROSSREF_LIMIT=40

# LLM Providers (OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=
NVIDIA_API_KEY1=
NVIDIA_MODEL1=
NVIDIA_BASE_URL1=
NVIDIA_API_KEY2=
NVIDIA_MODEL2=
NVIDIA_BASE_URL2=
LLM_PROVIDER_MAX=8
DYNAMIC_LLM_ENABLED=true
LLM_REQUIRED=false
LLM_STRUCTURED_TEMPERATURE=0.35
LLM_CREATIVE_TEMPERATURE=0.75

# Storage
UPLOAD_DIR=./data/uploads
CACHE_DIR=./data/cache
STORAGE_BACKEND=local
# For LocalStack S3, set STORAGE_BACKEND=s3.
# Docker Compose backend uses http://localstack:4566.
# Host uv runs should override this to http://127.0.0.1:4566.
S3_BUCKET=research-uploads
S3_ENDPOINT_URL=http://localstack:4566
S3_REGION=us-east-1
S3_PREFIX=papers
STORAGE_FALLBACK_TO_LOCAL=true

# Full-text PDF enrichment
ENABLE_FULL_TEXT_DOWNLOAD=true
FULL_TEXT_DOWNLOAD_LIMIT=10
MIN_EXTRACTED_PDF_TEXT_CHARS=300
PDF_DOWNLOAD_MAX_RETRIES=4
PDF_DOWNLOAD_TIMEOUT_SECONDS=25
PDF_DOWNLOAD_DIRECT_FIRST=true
PROXY_SOURCE_URLS=https://raw.githubusercontent.com/iplocate/free-proxy-list/main/protocols/http.txt,https://raw.githubusercontent.com/iplocate/free-proxy-list/main/protocols/https.txt
PROXY_CACHE_TTL_SECONDS=1800
PROXY_REFRESH_ON_FAILURES=2
PROXY_USE_DIRECT_FALLBACK=true
