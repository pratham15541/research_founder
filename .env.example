# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=research_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_pass@127.0.0.1:5432/research_db

# External API Integrations
# OpenAlex polite pool email (enables 100k requests/day and 10 req/sec)
OPENALEX_EMAIL=researcher@example.edu

# Semantic Scholar API Key (optional, enables 1 req/sec reliable access)
S2_API_KEY=

# LLM Providers
GEMINI_API_KEY=your_google_gemini_api_key
# LLM Providers (NVIDIA NGC API)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=moonshotai/kimi-k3
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Local Sandbox Storage
UPLOAD_DIR=./data/uploads
CACHE_DIR=./data/cache

