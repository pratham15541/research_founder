# Database Configuration (PostgreSQL 16 + pgvector or SQLite)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=research_db
DATABASE_URL=sqlite+aiosqlite:///./data/cache/compounding_research.db
# For PostgreSQL / AWS Aurora:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_pass@127.0.0.1:5432/research_db

# External API Integrations
# OpenAlex polite pool email (enables 100k requests/day and 10 req/sec)
OPENALEX_EMAIL=researcher@example.edu

# Semantic Scholar API Key (optional, enables 1 req/sec reliable access)
S2_API_KEY=

# --- AWS Cloud & Open-Source Stack ---
USE_AWS=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# LocalStack Settings (Local AWS Emulator - no AWS account/credit needed)
USE_LOCALSTACK=false
LOCALSTACK_ENDPOINT=http://localhost:4566

# Amazon Bedrock LLM & Embeddings
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
AWS_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Amazon S3 Document Storage
S3_BUCKET_NAME=research-founder-artifacts

# Amazon OpenSearch Vector Search
OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX_NAME=research-papers
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# --- Legacy / Alternative LLM Providers ---
NVIDIA_API_KEY=your_nvidia_or_openrouter_api_key
NVIDIA_MODEL=z-ai/glm-5.2:free
NVIDIA_BASE_URL=https://openrouter.ai/api/v1
GEMINI_API_KEY=

# Local Sandbox Storage
UPLOAD_DIR=./data/uploads
CACHE_DIR=./data/cache


